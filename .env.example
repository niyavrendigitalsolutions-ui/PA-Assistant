# ---- Required everywhere ----
ANTHROPIC_API_KEY=

# ---- Required for the web service (server.py; in Fly this is a secret) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASSISTANT_ACCESS_TOKEN=

# ---- Optional ----
ASSISTANT_NAME=Nova
ASSISTANT_TZ=Asia/Kolkata
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_DATA_DIR=~/.personal_assistant
MAX_TURNS=15

# ---- Gmail + Google Calendar (optional; run get_google_token.py once) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Business limits (hard limits enforced in code; the assistant cannot change them) ----
TRUSTED_RECIPIENTS=            # comma list of emails or @domains it may email without asking you
MAX_EMAILS_PER_DAY=5
MAX_EMAILS_PER_RECIPIENT_PER_DAY=2
AUTONOMY=limited               # set to "off" to make every email wait for your approval
EMAIL_SIGNATURE=               # optional; default discloses that an AI assistant sent it

# ---- Code sandbox (separate Fly app; see DEPLOY.md) ----
SANDBOX_URL=                   # e.g. https://niyavren-sandbox.fly.dev
SANDBOX_TOKEN=                 # long random string; the same value is set on the sandbox app
