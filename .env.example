# ---- Required everywhere ----
ANTHROPIC_API_KEY=

# ---- Optional ----
ASSISTANT_NAME=Nova
ASSISTANT_TZ=Asia/Kolkata
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_DATA_DIR=~/.personal_assistant
MAX_TURNS=15

# ---- WhatsApp (needed by server.py; in Fly these are secrets) ----
WHATSAPP_TOKEN=             # Meta access token (use a permanent System User token)
WHATSAPP_PHONE_NUMBER_ID=   # from Meta developer dashboard > WhatsApp > API setup
WHATSAPP_VERIFY_TOKEN=      # any long random string you invent; paste the same in Meta
WHATSAPP_APP_SECRET=        # Meta app > Settings > Basic > App secret
OWNER_WHATSAPP=             # your number with country code, digits only, e.g. 919876543210

# ---- Gmail + Google Calendar (optional; run get_google_token.py once) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
